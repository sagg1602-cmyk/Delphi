# Copy this file to .env.local (cp .env.example .env.local), then restart `npm run dev`.

# Where the Delphi API (backend) is running
NEXT_PUBLIC_API_URL=http://localhost:8000

# true  = Today shows the sample fixture (labeled "Sample data")
# false = Today calls POST /recommendations/generate on the live API
NEXT_PUBLIC_USE_FIXTURES=false
